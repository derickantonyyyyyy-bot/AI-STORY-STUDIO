# Copy this file to .env and add your own Groq key.
# Never commit .env or paste secrets into frontend code.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Optional: free-tier Cloudflare Workers AI image generation (keep both values private).
IMAGE_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_STEPS=4
PORT=8787
